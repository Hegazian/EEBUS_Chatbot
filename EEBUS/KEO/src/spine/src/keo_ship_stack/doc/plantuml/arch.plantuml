@startuml
title SHIP Stack Architecture - Sequential Layers

node "Core Stack Logic" {
    [ShipStack] <<Component>>
    [SocketConnectionHandler] <<Component>>
}

node "Utility Components" {
    [ShipTimer] <<Component>>
    [URI Utilities] <<Component>>
}

node "Security Layer" {
    [X509Certificate] <<Component>>
    [TLS Authentication] <<Component>>
    [Base64 Utilities] <<Component>>
}

node "Service Discovery Layer" {
    [ShipDiscovery] <<Component>>
    [ZeroConf (KEOZeroconf)] <<Component>>
    [ShipService] <<Component>>
}

node "Data Transformation Layer" {
    [ShipDataTransformer] <<Component>>
    [JsonParser] <<Component>>
    [JsonBuilder] <<Component>>
    [ClassBuilder] <<Component>>
}

node "Message Exchange Layer" {
    [ShipMessageExchange] <<Component>>
    [ProtocolConfig] <<Component>>
    [StateHandler] <<Component>>
    [ShipByteArray] <<Component>>
}

node "Transport Layer" {
    [SocketServer] <<Component>>
    [ShipSocket] <<Component>>
    [WebSocketParser] <<Component>>
    [TLS (e.g., ShipOpenSSL)] <<Component>>
}

"Transport Layer" <.. "Message Exchange Layer"
"Message Exchange Layer" <.. "Data Transformation Layer"
"Data Transformation Layer" <.. "Service Discovery Layer"
"Service Discovery Layer" <.. "Security Layer"
"Security Layer" <.. "Utility Components"
"Utility Components" <.. "Core Stack Logic"

@enduml