/**
 * @namespace keo_spine_example_client This namespace holds the classes for the simple client example.
 */

/**
 * @namespace keo_spine_example_server This namespace holds the classes for the simple server example.
 */

/** @defgroup examples_framework SPINE application examples
 *
 * This module offers example applications that demonstrate how to use the KEO SPINE API. 
 *
 * The examples are a good starting point to accelerate the process of understanding SPINE fundamentals and how to use the KEO SPINE API.
 *
 * @ingroup examples
 */

/** @defgroup framework_example_client KEO SPINE client application example
 *
 * This module offers a KEO SPINE client application example.
 *
 * @ingroup examples_framework
 *
 * The example client demonstrates how to establish a connection to the example server
 * and how to subscribe to a server feature.
 * 
 * The ExampleClientApplication creates the following objects:
 * @startuml
 * ExampleClientApplication          *-- keo_spine::ShipTransportConfiguration
 * ExampleClientApplication          *-- keo_spine::SpineLink
 * ExampleClientApplication          *-- keo_spine::SmartDevice
 * ExampleClientApplication          *-- keo_spine_example_client::MeasurementClientFeature
 * ExampleClientApplication          *-- keo_spine_example_client::ShipController
 * ExampleClientApplication          *-- example::ExampleSecurityHandler
 * @enduml
 * 
 * Inheritance relations
 * ---------------------
 * 
 * ExampleClientApplication
 * @startuml
 * ExampleClientApplication         <|-- keo_spine::DeviceCallbackHandler
 * @enduml
 * 
 * ShipController
 * @startuml
 * ShipController         <|-- keo_spine::ShipTransportConnector
 * ShipController         <|-- keo_spine::ShipDiscoveryListener
 * @enduml
 * 
 * MeasurementClientFeature
 * @startuml
 * MeasurementClientFeature         <|-- keo_spine::ClientFeature
 * @enduml
 * 
 **/


/** @defgroup framework_example_server KEO SPINE server application example
 *
 * This module offers the KEO SPINE server application example.
 *
 * @ingroup examples_framework
 *
 * The example server demonstrates how to implement a server feature 
 * and how to implement a subscription.
 * 
 * The ExampleServerApplication creates the following objects:
 * @startuml
 * ExampleServerApplication          *-- keo_spine::ShipTransportConfiguration
 * ExampleServerApplication          *-- keo_spine::SpineLink
 * ExampleServerApplication          *-- keo_spine::SmartDevice
 * ExampleServerApplication          *-- keo_spine_example_server::MeasurementServerFeature
 * ExampleServerApplication          *-- keo_spine_example_server::ShipController
 * ExampleServerApplication          *-- example::ExampleSecurityHandler
 * @enduml
 * 
 * Inheritance relations
 * ---------------------
 * 
 * ExampleServerApplication
 * @startuml
 * ExampleServerApplication         <|-- keo_spine::DeviceCallbackHandler
 * @enduml
 * 
 * ShipController
 * @startuml
 * ShipController         <|-- keo_spine::ShipTransportConnector
 * ShipController         <|-- keo_spine::ShipDiscoveryListener
 * @enduml
 * 
 * MeasurementServerFeature
 * @startuml
 * MeasurementServerFeature         <|-- keo_spine::ServerFeature
 * MeasurementServerFeature         <|-- keo_util::TimerHandlerInterface
 * @enduml
 * 
 **/
